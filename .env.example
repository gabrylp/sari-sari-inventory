# Copy this file to .env.local and fill in real values.

# Supabase (public-safe, sent to the browser only as config)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets - NEVER prefix these with NEXT_PUBLIC_
# Password to sign in to the store's inventory
AUTH_PASSWORD=choose-a-strong-password
# Random string used to sign the session cookie (use a long random value)
AUTH_SECRET=

# Supabase service role key - can bypass RLS, keep it server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key